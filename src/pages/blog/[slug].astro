---
import BaseLayout from '../../layouts/BaseLayout.astro'; import CTA from '../../components/CTA.astro';
export function getStaticPaths(){return [
{params:{slug:'locacao-ou-compra'},props:{title:'Locação de laser ou compra: qual modelo faz sentido para uma clínica?',intro:'A escolha depende da agenda, do capital disponível, da demanda e do nível de flexibilidade que a clínica precisa.',sections:[['Comece pela operação','Antes de comparar equipamentos, entenda quantos atendimentos você pretende organizar e se existe uma demanda que justifique uma operação recorrente.'],['Quando a locação faz sentido','A locação pode ser interessante para testar a demanda, realizar um Laser Day e acessar uma plataforma profissional sem comprar o equipamento.'],['Planeje com dados reais','Considere agenda, equipe, logística e comunicação com os clientes.']]}},
{params:{slug:'o-que-e-laser-day'},props:{title:'O que é Laser Day e como funciona?',intro:'Laser Day é uma operação concentrada: a clínica organiza a agenda e reserva um equipamento para realizar atendimentos em uma data planejada.',sections:[['A agenda vem primeiro','A clínica estrutura os horários, comunica seus clientes e define a data desejada.'],['Entrega e preparação','A Áurea Laser entrega, monta e prepara o equipamento conforme o planejamento combinado.'],['Atendimento e retirada','A clínica realiza os atendimentos e, após o período contratado, o equipamento é retirado conforme combinado.']]}},
{params:{slug:'triple-wave'},props:{title:'Ácrus HTM Triple Wave: como funciona a tecnologia?',intro:'O Ácrus HTM Triple Wave combina Alexandrite 755 nm, Diodo 808 nm e Nd:YAG 1064 nm.',sections:[['Três comprimentos de onda','Cada faixa possui características próprias. A escolha de parâmetros depende de avaliação e da atuação de profissional habilitado.'],['Resfriamento da ponteira','O equipamento possui sistema de resfriamento, um recurso que integra a preparação do atendimento.'],['Para clínicas','Na locação, o equipamento pode ser usado em operações planejadas como Laser Day, sempre conforme disponibilidade.']]}},
{params:{slug:'alexandrite-diodo-ndyag'},props:{title:'Alexandrite, Diodo e Nd:YAG: entenda as diferenças',intro:'Os três comprimentos de onda presentes no Ácrus HTM têm características distintas e ampliam as possibilidades de uma plataforma Triple Wave.',sections:[['Alexandrite 755 nm','Uma faixa de Alexandrite integrada à plataforma.'],['Diodo 808 nm','A faixa de Diodo é parte da combinação Triple Wave.'],['Nd:YAG 1064 nm','A faixa Nd:YAG completa a plataforma. Protocolos e parâmetros devem ser definidos conforme avaliação.']]}}
];}
const {title,intro,sections}=Astro.props;
---
<BaseLayout title={`${title} | Áurea Laser`} description={intro} breadcrumbs={[{label:'Blog',href:'/blog/'},{label:title}]}><article class="section"><div class="container prose"><span class="eyebrow">Guia Áurea Laser</span><h1>{title}</h1><p style="font-size:1.25rem">{intro}</p>{sections.map((section:any)=><section><h2>{section[0]}</h2><p>{section[1]}</p></section>)}<p style="margin-top:3rem"><a href="/acrus-htm/">Conheça o Ácrus HTM</a> ou <a href="/locacao-laser/">entenda a locação</a>.</p></div></article><CTA/></BaseLayout>
