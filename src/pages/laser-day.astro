---
import BaseLayout from '../layouts/BaseLayout.astro'; import CTA from '../components/CTA.astro'; import {whatsappUrl} from '../data/site';
const steps=[['01','A clínica agenda','Você concentra os clientes e estrutura o dia de atendimentos.'],['02','A Áurea entrega','O equipamento é levado ao local conforme data e logística combinadas.'],['03','Montagem e preparo','A máquina é montada e preparada tecnicamente para a operação.'],['04','Os atendimentos acontecem','A clínica realiza os atendimentos com sua equipe ou profissional previamente combinado.'],['05','Retirada conforme combinado','Ao final do período, o equipamento é retirado conforme o planejamento.']];
---
<BaseLayout title="Laser Day: Locação de Laser para Clínicas | Áurea Laser" description="Organize um Laser Day na sua clínica com locação do Ácrus HTM, entrega, montagem e preparação técnica na Baixada Santista." breadcrumbs={[{label:'Laser Day'}]}>
<section class="section" style="background:var(--ink);color:#fff"><div class="container" style="max-width:900px"><span class="eyebrow">Operação concentrada</span><h1 style="color:#fff">Laser Day: transforme um dia da sua agenda em uma operação de depilação a laser.</h1><p style="color:#d5e1de;font-size:1.25rem">Organize a agenda, reserve o equipamento e ofereça uma experiência planejada para sua clínica.</p><a class="btn btn-primary" href={whatsappUrl('Olá! Quero organizar um Laser Day e consultar a disponibilidade do Ácrus HTM.')}>Quero organizar meu Laser Day</a></div></section>
<section class="section"><div class="container"><span class="eyebrow">Em cinco etapas</span><h2>Um processo simples de entender.</h2><div class="grid cards-3" style="margin-top:2rem">{steps.map(([n,t,d])=><div class="card"><span class="numbers">{n}</span><h3>{t}</h3><p>{d}</p></div>)}</div></div></section><CTA label="Quero fazer um Laser Day"/>
</BaseLayout>
